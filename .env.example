# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose (port 5435). Neon in staging/production.
DATABASE_URL="postgresql://clientstatus:clientstatus@localhost:5435/clientstatus"
TEST_DATABASE_URL="postgresql://clientstatus:clientstatus@localhost:5435/clientstatus_test"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend. EMAIL_DELIVERY defaults to "mailbox" outside production: emails are
# printed and appended to .dev-mailbox/emails.jsonl instead of being sent.
EMAIL_DELIVERY=""
RESEND_API_KEY=""
EMAIL_FROM="Client Status <alerts@example.com>"
# Signing secret of the Resend webhook pointing at /api/webhooks/resend (bounces).
RESEND_WEBHOOK_SECRET=""

# Where generated PDFs and uploaded logos are stored (defaults to ./storage).
STORAGE_DIR=""

# Worker health endpoint and how many checks run at once.
WORKER_HEALTH_PORT="3001"
WORKER_CONCURRENCY="32"
# Concurrent audits and PDF renders (the long-job lane).
WORKER_AUDIT_CONCURRENCY="4"

# Paddle billing (sandbox while testing). Without all of these the Billing page
# says billing isn't configured. API key: Paddle → Developer tools → Authentication.
# Webhook secret: the notification destination pointing at /api/webhooks/paddle.
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_STARTER=""
PADDLE_PRICE_GROWTH=""
PADDLE_PRICE_PRO=""

# Internal ops dashboard (/ops) and the worker's /metrics: comma-separated staff emails.
OPS_ADMIN_EMAILS=""
